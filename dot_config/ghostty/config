# # vi:ft=conf
#
# docs:
# ghostty +show-config --default --docs | nvim
#

auto-update-channel = tip

# fonts
# ghostty +list-fonts
font-family = "JetBrainsMono Nerd Font"
font-family-bold = "JetBrainsMono Nerd Font"
font-family-italic = "JetBrainsMono Nerd Font"
font-family-bold-italic = "JetBrainsMono Nerd Font"
# ss01: != and ===
font-feature = "ss01"
# ss02: <= and >=
font-feature = "ss02"
# ss03: -> and ~>
font-feature = "ss03"
# ss04: <> and </>
font-feature = "ss04"
# liga: //, ..., ||
font-feature = "liga"
font-size = 16

command = /usr/bin/env zsh --login -c "if [ -x "$(command -v tmux)" ] && [ -n "${DISPLAY}" ] && [ -z "${TMUX}" ]; then tmux new -A -s mac >/dev/null 2>&1; fi"

cursor-style = block
cursor-style-blink = true

macos-option-as-alt = true
macos-titlebar-style = tabs

# Send CSI u sequences for Ctrl+Enter and Shift+Enter
keybind = ctrl+enter=text:\x1b[13;5u
keybind = shift+enter=text:\x1b[13;2u

# mouse
mouse-hide-while-typing = true

# shell
shell-integration = zsh
shell-integration-features = cursor,sudo,no-title

# theme
# ghostty +list-themes
#theme = dark:Catppuccin Mocha,light:Catppuccin Latte
theme = Catppuccin Mocha
background = #000000
#background-opacity = 0.95
#background-blur-radius = 20
window-theme = ghostty

# window
window-decoration = true
window-padding-balance = true
window-save-state = always

working-directory = home
